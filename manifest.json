{
  "manifest_version": 3,
  "name": "Claim Evidence Layer",
  "description": "One-click fact, opinion, and evidence overlay for web articles.",
  "version": "0.1.0",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "https://api.openai.com/*",
    "https://mp.weixin.qq.com/*",
    "<all_urls>"
  ],
  "action": {
    "default_title": "Check evidence",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content_script.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
